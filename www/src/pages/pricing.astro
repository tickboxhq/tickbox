---
import Layout from '../layouts/Layout.astro'

// The four live cloud tiers — these match packages' plan catalogue and the
// Stripe Prices behind the dashboard exactly. Everyone starts on Free (no
// card), so every CTA is "Start free" → the dashboard, where the upgrade
// to a paid tier happens via Stripe Checkout. The OSS SDK itself is free
// forever; that message lives in the hero, not as a tier here.
const tiers = [
  {
    name: 'Free',
    priceLine: '£0',
    priceSub: 'forever',
    blurb: 'For a personal site or a trial. No card needed.',
    features: ['1 site', '5,000 events / month', '30-day retention', 'Audit log + dashboard'],
    cta: { label: 'Start free', href: 'https://app.tickbox.dev' },
    highlight: false,
  },
  {
    name: 'Entry',
    priceLine: '£9',
    priceSub: '/ month',
    blurb: 'A single production site.',
    features: [
      '1 site',
      '25,000 events / month',
      '90-day retention',
      'CSV export',
      'Email support',
    ],
    cta: { label: 'Start free', href: 'https://app.tickbox.dev' },
    highlight: false,
  },
  {
    name: 'Pro',
    priceLine: '£29',
    priceSub: '/ month',
    blurb: 'Up to three sites, a year of retention.',
    features: [
      '3 sites',
      '100,000 events / month',
      '1-year retention',
      'CSV export',
      'Email support',
    ],
    cta: { label: 'Start free', href: 'https://app.tickbox.dev' },
    highlight: true,
  },
  {
    name: 'Unlimited',
    priceLine: '£99',
    priceSub: '/ month',
    blurb: 'No site or event limits, retention you set.',
    features: [
      'Unlimited sites',
      'Unlimited events',
      'Custom retention',
      'CSV export',
      'Priority support',
    ],
    cta: { label: 'Start free', href: 'https://app.tickbox.dev' },
    highlight: false,
  },
]

// Product schema with three Offers — lets Google show pricing under the
// pricing-page result in SERPs and feeds price-comparison crawlers. Uses
// the actual GBP numbers from packages/cli/src/plans equivalents.
const pricingSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Tickbox Cloud',
  description:
    'Cloud audit-log dashboard + remote banner editor on top of the MIT-licensed Tickbox OSS SDK.',
  brand: { '@id': 'https://tickbox.dev/#organization' },
  url: 'https://tickbox.dev/pricing/',
  offers: [
    {
      '@type': 'Offer',
      name: 'Entry',
      price: '9.00',
      priceCurrency: 'GBP',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: '9.00',
        priceCurrency: 'GBP',
        unitText: 'MONTH',
      },
      availability: 'https://schema.org/InStock',
      url: 'https://tickbox.dev/pricing/',
    },
    {
      '@type': 'Offer',
      name: 'Pro',
      price: '29.00',
      priceCurrency: 'GBP',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: '29.00',
        priceCurrency: 'GBP',
        unitText: 'MONTH',
      },
      availability: 'https://schema.org/InStock',
      url: 'https://tickbox.dev/pricing/',
    },
    {
      '@type': 'Offer',
      name: 'Unlimited',
      price: '99.00',
      priceCurrency: 'GBP',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: '99.00',
        priceCurrency: 'GBP',
        unitText: 'MONTH',
      },
      availability: 'https://schema.org/InStock',
      url: 'https://tickbox.dev/pricing/',
    },
  ],
}
---

<Layout
  title="Pricing"
  description="Tickbox OSS SDK is free forever (MIT). Cloud tier from £9/month — audit log, remote banner editor, CSV export. Pay for the dashboard, not the SDK."
  jsonLd={pricingSchema}
>
  <!-- HEADER -->
  <section class="border-b border-[color:var(--color-ink)]">
    <div class="mx-auto max-w-[78rem] px-6 lg:px-10 pt-16 pb-20 lg:pt-20 lg:pb-24">
      <p class="eyebrow mb-6">Spec · §2 — Tiers</p>
      <div class="grid lg:grid-cols-[1.5fr_1fr] gap-12 items-end">
        <h1 class="display text-[clamp(2.75rem,7vw,5.5rem)]">
          Pay for the dashboard,
          <span class="block italic-display text-[color:var(--color-muted)]">
            not the SDK.
          </span>
        </h1>
        <p class="text-lg text-[color:var(--color-ink-soft)] leading-relaxed">
          The whole SDK is OSS forever. Tickbox Cloud is opt-in — add an audit
          log and a banner editor when you outgrow code-only config.
        </p>
      </div>
    </div>
  </section>

  <!-- TIERS -->
  <section>
    <div class="mx-auto max-w-[78rem] px-6 lg:px-10 py-16 lg:py-20">
      <div class="grid md:grid-cols-2 lg:grid-cols-4 border border-[color:var(--color-ink)]">
        {tiers.map((t, i) => (
          <article
            class:list={[
              'tier-cell',
              t.highlight && 'tier-cell--featured',
              'border-t md:border-t-0 border-[color:var(--color-ink)]',
              i > 0 && 'lg:border-l',
              i === 1 && 'md:border-l',
              i === 3 && 'md:border-l',
              i >= 2 && 'md:border-t',
            ]}
          >
            <header class="mb-6">
              <div class="flex items-center justify-between mb-5 min-h-[1.5rem]">
                <span class="eyebrow">{t.name}</span>
                {t.highlight && (
                  <span class="px-2 py-0.5 text-[0.65rem] font-mono uppercase tracking-[0.12em] bg-[color:var(--color-accent)] text-[color:var(--color-accent-ink)]">
                    Popular
                  </span>
                )}
              </div>
              <p class="font-display text-[2.75rem] leading-[0.95]">
                {t.priceLine}
                <span class="italic-display text-[1.25rem] text-[color:var(--color-muted)]">
                  &nbsp;{t.priceSub}
                </span>
              </p>
              <p class="mt-3 text-[0.9rem] leading-relaxed opacity-80 min-h-[3rem]">
                {t.blurb}
              </p>
            </header>

            <ul class="space-y-2.5 text-[0.875rem] leading-relaxed mb-8">
              {t.features.map((f) => (
                <li class="flex items-start gap-2.5">
                  <span class:list={['tick mt-1.5 shrink-0', t.highlight && 'tick-filled']} aria-hidden="true"></span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>

            <a
              href={t.cta.href}
              class:list={[t.highlight ? 'btn-ink !bg-[color:var(--color-accent)] !text-[color:var(--color-accent-ink)] !border-[color:var(--color-accent)] hover:!bg-[color:var(--color-paper)]' : 'btn-ink', 'w-full justify-center']}
              rel="noopener"
            >
              {t.cta.label}
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>

      <p class="mt-10 text-center text-[color:var(--color-ink-soft)] leading-relaxed">
        Every plan starts on the free tier — no card to begin. Upgrade,
        downgrade or cancel anytime from the dashboard. Prices in GBP,
        billed monthly via Stripe.
      </p>
      <p class="mt-3 text-center eyebrow">
        Need SSO, a DPA, custom retention or an invoice?
        <a href="mailto:hello@tinysystems.io?subject=Tickbox%20Enterprise" class="underline decoration-[color:var(--color-accent)] decoration-2 underline-offset-4 hover:text-[color:var(--color-ink)]">
          Talk to us about Enterprise ↗
        </a>
      </p>
    </div>
  </section>

  <!-- COMPARISON CALLOUT -->
  <section class="border-t border-[color:var(--color-ink)] bg-[color:var(--color-paper-2)]">
    <div class="mx-auto max-w-[78rem] px-6 lg:px-10 py-20">
      <div class="grid lg:grid-cols-[1fr_2fr] gap-10 lg:gap-16 items-start">
        <h2 class="display text-[clamp(2rem,4.5vw,3.5rem)] leading-[0.95]">
          Where everyone else <span class="italic-display text-[color:var(--color-muted)]">charges per visitor.</span>
        </h2>
        <div class="space-y-6 text-[1.05rem] leading-relaxed text-[color:var(--color-ink-soft)]">
          <p>
            OneTrust and Cookiebot charge per session or per pageview because
            that's how legacy CMPs were architected — every consent banner is
            an iframe served from their CDN, so they bill for what they serve.
          </p>
          <p class="text-[color:var(--color-ink)]">
            Tickbox's SDK runs on your site. Our cloud only sees consent
            decisions you actively send via the opt-in beacon — so we charge
            for that, not for visits we never touched.
          </p>
        </div>
      </div>
    </div>
  </section>

  <style>
    .tier-cell {
      padding: 2.5rem 2rem;
      background: var(--color-paper);
      color: var(--color-ink);
      display: flex;
      flex-direction: column;
    }
    .tier-cell--featured {
      background: var(--color-ink);
      color: var(--color-paper);
    }
    .tier-cell--featured .opacity-80 {
      opacity: 0.75;
    }
  </style>
</Layout>
